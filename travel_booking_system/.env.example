# YATRIVO Database Configuration
# Copy this file to .env and configure your MySQL credentials

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=travelnest_db

# Primary database backend: 'mysql'
# Set to 'sqlite' only if running offline without a MySQL server
DB_BACKEND=mysql

# Administrator Enrollment Verification Code (Server Secret)
# Used to verify privileged administrator account registration requests
ADMIN_ENROLLMENT_CODE=YATRIVO_ADMIN_2026

